# Copy to .env and fill in. .env is not committed.

DB_URL=jdbc:postgresql://localhost:5432/chatbot_dev_db
DB_USER=postgres
DB_PASSWORD=

# https://chat.botpress.cloud/<id>
# R&D: <id> is the Webchat client ID from the Webchat share config.
BOTPRESS_BASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gemini voice (mic transcription and read-aloud). Empty = voice off (the endpoints answer 503).
GEMINI_API_KEY=
# Optional overrides. Models are tried in order; an overloaded or slow model falls through to the next.
# GEMINI_TRANSCRIBE_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore

# Live chat auto-close when the customer is inactive (requirement: 2 minutes). Off = only the agent closes the chat.
HANDOVER_AUTO_CLOSE=false
HANDOVER_INACTIVITY_TIMEOUT=2m
# While no agent has accepted, remind the customer this often ("our agents are still busy..."). 0 = off.
HANDOVER_WAITING_REMINDER=60s
# BRD auto-route: urgent messages, asking for a person in words, or two failed bot answers open a live agent request.
AUTO_ROUTE=true
# Chat history (bot turns and live chat messages) is deleted after this many days; 0 = kept.
CHAT_RETENTION_DAYS=90
# Assignment rules (docs/handover.md): each chat has one agent; one agent has at most this many live chats (0 = no limit).
AGENT_MAX_CHATS=2
# Botpress Desk: agents may take over chats the customer did not ask an agent for. false = only customers who asked.
AGENT_TAKEOVER=false

# How agents reach this backend; file links posted to Botpress Desk point here.
PUBLIC_BASE_URL=http://localhost:8080

# Customer file uploads: deleted after N days. Virus scan with ClamAV (off until ClamAV is installed).
ATTACHMENT_RETENTION_DAYS=30
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Files a customer can send while chatting with the AI, per chat.
ATTACHMENT_MAX_PER_SESSION=5

# Reading the text in files sent to the AI chat, on this server (docs/attachments-ai-chat.md).
# Off: files can still be sent, the bot offers an agent. To switch on: put eng.traineddata and khm.traineddata
# (https://github.com/tesseract-ocr/tessdata) in backend/tessdata/ and set OCR_ENABLED=true.
OCR_ENABLED=false
# embedded = Tesseract bundled with the backend (Windows x64, nothing to install);
# program = an installed tesseract program (e.g. Linux: apt install tesseract-ocr tesseract-ocr-khm)
OCR_ENGINE=embedded
# Folder with the .traineddata files; empty = backend/tessdata (embedded) or Tesseract's own (program)
OCR_TESSDATA_DIR=
# program engine only
OCR_TESSERACT_PATH=tesseract
OCR_LANGUAGES=khm+eng
OCR_TIMEOUT=10s
# Lines Tesseract is less sure about (0-100) are dropped (noise from icons and photos)
OCR_MIN_CONFIDENCE=60

# Agent login for the secure file page that Botpress Desk links to (http://localhost:8080/agent/file.html).
# If AGENT_PASSWORD is empty, a password is generated at startup and printed in the log.
AGENT_USERNAME=agent
AGENT_PASSWORD=
