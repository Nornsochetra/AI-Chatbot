# Copy to .env and fill in. .env is not committed.

DB_URL=jdbc:postgresql://localhost:5432/chatbot_dev_db
DB_USER=postgres
DB_PASSWORD=

# https://chat.botpress.cloud/<id>
# R&D: <id> is the Webchat client ID from the Webchat share config.
BOTPRESS_BASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gemini voice (mic transcription and read-aloud). Empty = voice off (the endpoints answer 503).
GEMINI_API_KEY=
# Optional overrides. Models are tried in order; an overloaded or slow model falls through to the next.
# GEMINI_TRANSCRIBE_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
# GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Kore

# Live chat auto-close when the customer is inactive (requirement: 2 minutes). Off = only the agent closes the chat.
HANDOVER_AUTO_CLOSE=false
HANDOVER_INACTIVITY_TIMEOUT=2m
# While no agent has accepted, remind the customer this often ("our agents are still busy..."). 0 = off.
HANDOVER_WAITING_REMINDER=60s

# Where live agents work: console (our /agent page) or botpress-desk (see docs/agent-inbox-switch.md).
# PUBLIC_BASE_URL: how agents reach this backend; Desk mode posts file links to it.
AGENT_INBOX=console
PUBLIC_BASE_URL=http://localhost:8080

# Customer file uploads: deleted after N days. Virus scan with ClamAV (off until ClamAV is installed).
ATTACHMENT_RETENTION_DAYS=30
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Built-in agent console login (http://localhost:8080/agent).
# If AGENT_PASSWORD is empty, a password is generated at startup and printed in the log.
AGENT_USERNAME=agent
AGENT_PASSWORD=
