# Normalize line endings in the repo; check out with the platform default
* text=auto

# Shell scripts must keep LF (they break on Linux / CI with CRLF)
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf

# Binary
*.jar binary
*.png binary
*.jpg binary
*.wav binary
